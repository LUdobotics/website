{
  "name": "ludobotics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://ludobotics.com",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/create-static-routes.mjs",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "sync:teacher-dashboard": "node scripts/sync-teacher-dashboard.mjs",
